# Local development only. Production requires a generated secret of 50+ characters.
DJANGO_SECRET_KEY=unsafe-local-development-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Exact frontend origins, separated by commas. No wildcard or trailing slash.
# On Render: DJANGO_CORS_ALLOWED_ORIGINS=https://os-portfolio-o54c.vercel.app
DJANGO_CORS_ALLOWED_ORIGINS=

DATABASE_URL=sqlite:///db.sqlite3

DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_URL=/media/

# Dashboard's "View portfolio" link (production defaults to the same-origin /).
DASHBOARD_PUBLIC_SITE_URL=http://127.0.0.1:5173/
# Enable only behind a trusted proxy that overwrites X-Real-IP.
DASHBOARD_TRUST_PROXY_IP=False

# Optional absolute paths; omitted values use staticfiles/ and media/ in the project.
# DJANGO_STATIC_ROOT=C:/path/to/staticfiles
# DJANGO_MEDIA_ROOT=C:/path/to/media

# Set DJANGO_SETTINGS_MODULE in the process environment before production startup.
# Only enable when your trusted proxy strips and sets X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
