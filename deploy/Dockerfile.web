FROM node:24-bookworm-slim AS builder
WORKDIR /site
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_API_BASE_URL=/api/v1 VITE_ALLOW_DEMO_FALLBACK=false
RUN npm run build

FROM caddy:2-alpine
COPY --from=builder /site/dist/client /srv/portfolio
COPY deploy/Caddyfile /etc/caddy/Caddyfile
